# Example Runtime Configuration (NO hardcoded API keys or secrets)
# All sensitive tokens are resolved dynamically from Google Cloud Secret Manager via ADC.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=enterprise-agentops-prod
GOOGLE_CLOUD_LOCATION=us-central1
AGENT_ENV=production
ENABLE_CLOUD_DLP_API=true
ENABLE_CLOUD_TRACE=true
ENABLE_CLOUD_LOGGING=true
ENABLE_FIRESTORE_SESSIONS=true
ENABLE_MODEL_ARMOR=true
# Secret IDs fetched via SecretManagerService.get_secret():
# - ISSUE_TRACKER_API_SECRET
# - CLOUD_DEPLOY_CONTROL_PLANE_TOKEN
